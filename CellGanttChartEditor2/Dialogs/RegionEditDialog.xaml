<Window x:Class="CellGanttChartEditor2.Dialogs.RegionEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename region"
        SizeToContent="Height" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Style="{StaticResource ThemedWindow}">
    <StackPanel Margin="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" x:Name="NameBox" Padding="3" Margin="0,3"/>

            <TextBlock Grid.Row="1" Text="Category" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CategoryBox" Padding="3" Margin="0,3"
                      DisplayMemberPath="Text"/>
        </Grid>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Redraw region" Width="110" Height="26" Click="Redraw_Click"
                    ToolTip="Apply these changes, then draw a new box on the image for this region."/>
            <Button Content="OK" Width="86" Height="26" Margin="8,0,0,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="86" Height="26" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
