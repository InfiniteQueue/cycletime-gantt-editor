<Window x:Class="CellGanttChartEditor2.Dialogs.LinkEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit link"
        SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Style="{StaticResource ThemedWindow}">
    <StackPanel Margin="14">
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Link length" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" x:Name="LagBox" Padding="3"/>
        </Grid>

        <TextBlock Text="Time between the end of the source operation and the start of the target."
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Delete link" Width="90" Height="26" Click="Delete_Click"/>
            <Button Content="OK" Width="86" Height="26" Margin="8,0,0,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="86" Height="26" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
