<Window x:Class="CellGanttChartEditor2.Dialogs.OperationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add operation"
        SizeToContent="Height" Width="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Style="{StaticResource ThemedWindow}">
    <!-- BasedOn keeps the app-level dark styles; a bare implicit style would drop back to the
         default light templates. -->
    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="14">
        <TextBlock x:Name="HeaderText" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Robot"/>
            <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="RobotBox" IsEditable="True" Height="29"/>
            <Button    Grid.Row="0" Grid.Column="2" x:Name="RobotPickButton"
                       Style="{StaticResource PickButton}" Click="PickRobot_Click"
                       ToolTip="Click the spot on the image where this robot sits."/>

            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RobotPlaceText"
                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                       Margin="0,0,0,4" Visibility="Collapsed"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Region"/>
            <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="RegionBox" SelectionChanged="Region_Changed"
                       Height="29"/>
            <Button    Grid.Row="2" Grid.Column="2" x:Name="RegionPickButton"
                       Style="{StaticResource PickButton}" Click="PickRegion_Click"
                       ToolTip="Draw a box on the image for a new region, or click one already there."/>

            <TextBlock Grid.Row="3" Grid.Column="0" x:Name="RegionNameLabel" Text="Region name"/>
            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="RegionNameBox" Padding="3,3,4,3" Height="29" TextChanged="RobotOrRegionUpdated"/>

            <TextBlock Grid.Row="4" Grid.Column="0" x:Name="CategoryLabel" Text="Region category" Margin="0,3,0,10"/>
            <ComboBox  Grid.Row="4" Grid.Column="1" x:Name="CategoryBox" DisplayMemberPath="Text" Margin="0,3,0,10" Height="29"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Operation"/>
            <TextBox  Grid.Row="5" Grid.Column="1" x:Name="OperationBox" Height="29" PreviewKeyDown="OperationBox_KeyDown"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Start time"/>
            <TextBox   Grid.Row="6" Grid.Column="1" x:Name="StartBox" Height="29"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Duration"/>
            <TextBox   Grid.Row="7" Grid.Column="1" x:Name="DurationBox" Height="29"/>

        </Grid>

        <TextBlock x:Name="RegionAreaText" Foreground="{StaticResource MutedBrush}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,4,0,0"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Width="86" Height="26" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="86" Height="26" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
