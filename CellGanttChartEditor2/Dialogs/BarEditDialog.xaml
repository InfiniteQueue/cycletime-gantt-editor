<Window x:Class="CellGanttChartEditor2.Dialogs.BarEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit operation"
        SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Style="{StaticResource ThemedWindow}">
    <!-- BasedOn keeps the app-level dark styles; a bare implicit style would drop back to the
         default light templates. -->
    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,10,4"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- The name is editable here: double-clicking a bar is the gesture for renaming an
                 operation, the same way double-clicking a row header renames a row. -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Operation"/>
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="OperationBox" FontWeight="Bold"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Robot"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RobotText"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Region"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RegionText"/>

            <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Start time"/>
            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="StartBox"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Duration"/>
            <TextBox   Grid.Row="5" Grid.Column="1" x:Name="DurationBox"/>
        </Grid>

        <Separator Margin="0,10"/>

        <TextBlock Text="Simultaneous with" FontWeight="SemiBold" Margin="0,0,0,2"/>
        <TextBlock Text="Work listed here is meant to happen at the same time as this operation, so the two never count as a conflict."
                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>

        <StackPanel x:Name="SimultaneousList"/>

        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Choose from the list, or go and point at the bar. Picking on the chart cannot happen
                 with this dialog up, so that button closes it and the chart reopens it. -->
            <ComboBox x:Name="SimultaneousBox" Grid.Column="0" VerticalAlignment="Center"
                      SelectionChanged="Simultaneous_Changed"/>
            <Button x:Name="PickSimultaneousButton" Grid.Column="1" Content="Pick on chart"
                    Padding="8,2" Margin="6,0,0,0" Click="PickSimultaneous_Click"
                    ToolTip="Close this and click the operation on the chart."/>
        </Grid>

        <TextBlock x:Name="DrivenText" TextWrapping="Wrap" Foreground="{StaticResource AccentTextBrush}" Margin="0,8,0,0"
                   Visibility="Collapsed"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Width="86" Height="26" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="86" Height="26" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
