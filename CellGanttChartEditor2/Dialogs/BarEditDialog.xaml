<Window x:Class="CellGanttChartEditor2.Dialogs.BarEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit operation"
        SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Style="{StaticResource ThemedWindow}">
    <!-- BasedOn keeps the app-level dark styles; a bare implicit style would drop back to the
         default light templates. -->
    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,10,4"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Operation"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="OperationText" FontWeight="Bold"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Robot"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RobotText"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Region"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RegionText"/>

            <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Start time"/>
            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="StartBox"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Duration"/>
            <TextBox   Grid.Row="5" Grid.Column="1" x:Name="DurationBox"/>
        </Grid>

        <TextBlock x:Name="DrivenText" TextWrapping="Wrap" Foreground="{StaticResource AccentTextBrush}" Margin="0,8,0,0"
                   Visibility="Collapsed"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Width="86" Height="26" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="86" Height="26" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
