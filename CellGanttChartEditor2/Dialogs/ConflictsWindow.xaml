<Window x:Class="CellGanttChartEditor2.Dialogs.ConflictsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlapping operations"
        Height="420" Width="760"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource ThemedWindow}">
    <DockPanel Margin="10">
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" Margin="0,0,0,8" FontWeight="Bold"/>
        <Button DockPanel.Dock="Bottom" Content="Close" Width="86" Height="26"
                HorizontalAlignment="Right" Margin="0,10,0,0" IsCancel="True"/>
        <ListView x:Name="ConflictList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Clash" Width="110" DisplayMemberBinding="{Binding Kind}"/>
                    <GridViewColumn Header="Operation A" Width="180" DisplayMemberBinding="{Binding A}"/>
                    <GridViewColumn Header="Operation B" Width="180" DisplayMemberBinding="{Binding B}"/>
                    <GridViewColumn Header="Shared" Width="150" DisplayMemberBinding="{Binding Shared}"/>
                    <GridViewColumn Header="Overlap" Width="80" DisplayMemberBinding="{Binding Overlap}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
