<UserControl x:Class="CellGanttChartEditor2.Controls.ItemListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="{StaticResource PanelBrush}">
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="10,8">
            <StackPanel>
                <TextBlock Text="All items" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedBrush}" FontSize="11"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ItemHost" Margin="8"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
